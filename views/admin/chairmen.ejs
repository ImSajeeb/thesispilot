<%- include('../partials/header') %>

<div class="container-fluid tp-main-content py-4 px-md-4" style="max-width: 1400px;">
    
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bolder tp-text-main mb-1" style="letter-spacing: -0.5px;">Department Chairmen</h2>
            <p class="tp-text-muted mb-0">Manage Chairman accounts and departmental assignments.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin/dashboard" class="btn tp-btn-surface shadow-sm d-flex align-items-center">
                <i class="bi bi-arrow-left me-2"></i> Dashboard
            </a>
            <button class="btn tp-btn-accent shadow-sm d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#addChairmanModal">
                <i class="bi bi-plus-lg me-2"></i> Add Chairman
            </button>
        </div>
    </div>

    <!-- Flash Messages -->
    <!-- <% if (typeof successMsg !== 'undefined' && successMsg.length > 0) { %>
        <div class="alert tp-alert-success border-0 shadow-sm rounded-3"><i class="bi bi-check-circle-fill me-2"></i><%= successMsg %></div>
    <% } %>
    <% if (typeof errorMsg !== 'undefined' && errorMsg.length > 0) { %>
        <div class="alert tp-alert-danger border-0 shadow-sm rounded-3"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= errorMsg %></div>
    <% } %> -->

    <!-- Data Table Card -->
    <div class="tp-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table tp-table tp-table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="px-4 py-3">Chairman Profile</th>
                        <th class="px-4 py-3">Credentials</th>
                        <th class="px-4 py-3">Department</th>
                        <th class="px-4 py-3">Status & Role</th>
                        <th class="px-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof chairmen !== 'undefined' && chairmen && chairmen.length > 0) { %>
                        <% chairmen.forEach(chairman => { %>
                            <tr>
                                <td class="px-4 py-3">
                                    <div class="fw-bold tp-text-main"><%= chairman.name %></div>
                                    <div class="tp-text-muted small mt-1"><i class="bi bi-envelope me-1"></i><%= chairman.email %></div>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="fw-semibold tp-text-main font-monospace"><%= chairman.employee_id || '—' %></div>
                                    <div class="tp-text-muted small mt-1">
                                        Joined: <%= chairman.created_at ? new Date(chairman.created_at).toLocaleDateString() : '—' %>
                                    </div>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="fw-bold tp-text-main mb-1"><%= chairman.department_name %></div>
                                    <% if (chairman.department_code) { %>
                                        <span class="tp-badge tp-badge-primary"><%= chairman.department_code %></span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-3">
                                    <% if (chairman.account_status === 'active') { %>
                                        <span class="tp-badge tp-badge-success">Account Active</span>
                                    <% } else { %>
                                        <span class="tp-badge tp-badge-danger">Account Disabled</span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <% if (chairman.account_status !== 'active') { %>
                                        <!-- Reactivate Button -->
                                        <form action="/admin/users/<%= chairman.user_id %>/reactivate" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm tp-btn-surface text-success me-1" onclick="return confirm('Reactivate this Chairman account?');">
                                                <i class="bi bi-arrow-counterclockwise"></i> Reactivate
                                            </button>
                                        </form>

                                        <!-- Hard Delete Button -->
                                        <form action="/admin/users/<%= chairman.user_id %>/hard-delete" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm tp-btn-outline-danger" onclick="return confirm('WARNING: This permanently wipes this Chairman from the database. Continue?');">
                                                <i class="bi bi-trash3-fill"></i> Delete
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <!-- Standard Active Actions -->
                                        <button class="btn btn-sm tp-btn-surface me-1" data-bs-toggle="modal" data-bs-target="#editModal-<%= chairman.id %>">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </button>
                                        <button class="btn btn-sm tp-btn-surface me-1" data-bs-toggle="modal" data-bs-target="#passwordModal-<%= chairman.user_id %>">
                                            <i class="bi bi-key"></i> Pass
                                        </button>

                                        <!-- Disable Toggle -->
                                        <form action="/admin/chairmen/<%= chairman.id %>/toggle-status" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm tp-btn-surface text-warning" onclick="return confirm('Archive/Disable this Chairman account?');">
                                                <i class="bi bi-archive"></i> Archive
                                            </button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="bi bi-person-x display-1 tp-text-muted mb-3 d-block opacity-50"></i>
                                <h5 class="fw-bold tp-text-main">No Chairmen Found</h5>
                                <p class="tp-text-muted">No Chairman accounts have been assigned yet.</p>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODALS PLACED SAFELY AT THE BOTTOM OF PAGE -->
<!-- ========================================== -->

<!-- Add Chairman Modal -->
<div class="modal fade" id="addChairmanModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content tp-card border-0 shadow-lg p-0">
            <div class="modal-header border-bottom-0 pb-2 pt-4 px-4">
                <h5 class="fw-bolder tp-text-main mb-0">Create Chairman</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/chairmen/create" method="POST">
                <div class="modal-body px-4 py-3">
                    <div class="mb-3">
                        <label class="form-label fw-bold tp-text-muted small text-uppercase">Full Name</label>
                        <input type="text" name="name" class="form-control tp-form-control py-2.5" autocomplete="off" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold tp-text-muted small text-uppercase">Email Address</label>
                        <input type="email" name="email" class="form-control tp-form-control py-2.5" autocomplete="new-password" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold tp-text-muted small text-uppercase">Employee ID</label>
                        <input type="text" name="employee_id" class="form-control tp-form-control py-2.5" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold tp-text-muted small text-uppercase">Department</label>
                        <select name="department_id" class="form-select tp-form-control py-2.5" required>
                            <option value="" style="background: var(--bg-base); color: var(--text-main);">Select department</option>
                            <% departments.forEach(dept => { %>
                                <% if (dept.status === 'active' && !dept.has_chairman) { %>
                                    <option value="<%= dept.id %>" style="background: var(--bg-base); color: var(--text-main);"><%= dept.name %> (<%= dept.code %>)</option>
                                <% } %>
                            <% }) %>
                        </select>
                        <small class="tp-text-muted mt-2 d-block"><i class="bi bi-info-circle me-1"></i>Only departments without a current Chairman are shown.</small>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold tp-text-muted small text-uppercase">Initial Password</label>
                        <input type="password" name="password" minlength="6" class="form-control tp-form-control py-2.5" autocomplete="new-password" required>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                    <button type="submit" class="btn tp-btn-accent w-100 py-2">Create Chairman</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit & Password Modals Loop -->
<% if (typeof chairmen !== 'undefined' && chairmen && chairmen.length > 0) { %>
    <% chairmen.forEach(chairman => { %>
        
        <!-- Edit Modal -->
        <div class="modal fade text-start" id="editModal-<%= chairman.id %>" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content tp-card border-0 shadow-lg p-0">
                    <div class="modal-header border-bottom-0 pb-2 pt-4 px-4">
                        <h5 class="fw-bolder tp-text-main mb-0">Edit Chairman</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/admin/chairmen/<%= chairman.id %>/update" method="POST">
                        <div class="modal-body px-4 py-3">
                            <div class="mb-3">
                                <label class="form-label fw-bold tp-text-muted small text-uppercase">Full Name</label>
                                <input type="text" name="name" class="form-control tp-form-control py-2.5" value="<%= chairman.name %>" autocomplete="off" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold tp-text-muted small text-uppercase">Email</label>
                                <input type="email" name="email" class="form-control tp-form-control py-2.5" value="<%= chairman.email %>" autocomplete="new-password" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold tp-text-muted small text-uppercase">Employee ID</label>
                                <input type="text" name="employee_id" class="form-control tp-form-control py-2.5" value="<%= chairman.employee_id %>" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold tp-text-muted small text-uppercase">Department</label>
                                <select name="department_id" class="form-select tp-form-control py-2.5" required>
                                    <% departments.forEach(dept => { %>
                                        <option value="<%= dept.id %>" <%= dept.id === chairman.department_id ? 'selected' : '' %> style="background: var(--bg-base); color: var(--text-main);"><%= dept.name %></option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                            <button type="submit" class="btn tp-btn-accent w-100 py-2">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Force Password Reset Modal -->
        <div class="modal fade text-start" id="passwordModal-<%= chairman.user_id %>" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content tp-card border-0 shadow-lg p-0">
                    <div class="modal-header border-bottom-0 pb-2 pt-4 px-4">
                        <h5 class="fw-bolder tp-text-main mb-0">Force Reset Password</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/admin/users/<%= chairman.user_id %>/reset-password" method="POST">
                        <div class="modal-body px-4 py-3">
                            <p class="tp-text-muted small mb-3">Set a new password for <strong class="tp-text-main"><%= chairman.name %></strong>.</p>
                            <div class="mb-3">
                                <label class="form-label fw-bold tp-text-muted small text-uppercase">New Password</label>
                                <input type="password" name="new_password" class="form-control tp-form-control py-2.5" minlength="4" required placeholder="Enter new password">
                            </div>
                        </div>
                        <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                            <button type="submit" class="btn btn-danger border-0 fw-bold w-100 py-2">Force Reset</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    <% }) %>
<% } %>

<%- include('../partials/footer') %>