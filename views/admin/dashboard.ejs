<%- include('../partials/header') %>

<link rel="stylesheet" href="/css/admin-dashboard.css">

<main class="container tp-main-content py-4">
    <!-- Page Header -->
    <section class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <span class="badge mb-2 px-3 py-2" style="background: rgba(234, 88, 12, 0.1); border: 1px solid var(--primary-color); color: var(--primary-light);">
                <i class="bi bi-grid-1x2-fill me-1"></i> ADMINISTRATOR WORKSPACE
            </span>
            <h1 class="tp-text-main display-6 fw-bold mb-1">System Administration</h1>
            <p class="tp-text-muted mb-0">Manage ThesisPilot's academic structure, users, and global settings.</p>
        </div>
        <div class="d-none d-md-flex align-items-center justify-content-center rounded-circle" 
             style="width: 70px; height: 70px; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); font-size: 2rem; color: var(--text-muted);">
            <i class="bi bi-shield-check"></i>
        </div>
    </section>

    <!-- Flash Messages -->
    <!-- <% if (typeof successMsg !== 'undefined' && successMsg && successMsg.length > 0) { %>
        <div class="alert tp-alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <span><%= successMsg %></span>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (typeof errorMsg !== 'undefined' && errorMsg && errorMsg.length > 0) { %>
        <div class="alert tp-alert-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <span><%= errorMsg %></span>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %> -->

    <!-- System Overview -->
    <section class="mb-5" aria-labelledby="overview-title">
        <div class="d-flex align-items-center mb-4">
            <div>
                <h3 id="overview-title" class="tp-text-main fw-bold mb-0">At a glance</h3>
                <p class="tp-text-muted small mb-0">Current records across your academic system</p>
            </div>
        </div>

        <div class="admin-stats-grid">
            <article class="tp-card admin-stat-card stat-primary">
                <div class="admin-stat-top">
                    <span class="tp-text-muted fw-semibold small text-uppercase">Departments</span>
                    <span class="admin-stat-icon"><i class="bi bi-buildings"></i></span>
                </div>
                <div class="admin-stat-value tp-text-main fw-bold display-5 mt-2 mb-1"><%= stats.departments %></div>
                <div class="tp-text-muted small">Academic units</div>
            </article>

            <article class="tp-card admin-stat-card stat-secondary">
                <div class="admin-stat-top">
                    <span class="tp-text-muted fw-semibold small text-uppercase">Sessions</span>
                    <span class="admin-stat-icon"><i class="bi bi-calendar3"></i></span>
                </div>
                <div class="admin-stat-value tp-text-main fw-bold display-5 mt-2 mb-1"><%= stats.sessions %></div>
                <div class="tp-text-muted small">Academic periods</div>
            </article>

            <article class="tp-card admin-stat-card stat-success">
                <div class="admin-stat-top">
                    <span class="tp-text-muted fw-semibold small text-uppercase">Chairmen</span>
                    <span class="admin-stat-icon"><i class="bi bi-person-workspace"></i></span>
                </div>
                <div class="admin-stat-value tp-text-main fw-bold display-5 mt-2 mb-1"><%= stats.chairmen %></div>
                <div class="tp-text-muted small">Department leadership</div>
            </article>

            <article class="tp-card admin-stat-card stat-warning">
                <div class="admin-stat-top">
                    <span class="tp-text-muted fw-semibold small text-uppercase">Supervisors</span>
                    <span class="admin-stat-icon"><i class="bi bi-person-badge"></i></span>
                </div>
                <div class="admin-stat-value tp-text-main fw-bold display-5 mt-2 mb-1"><%= stats.supervisors %></div>
                <div class="tp-text-muted small">Faculty members</div>
            </article>

            <article class="tp-card admin-stat-card stat-light">
                <div class="admin-stat-top">
                    <span class="tp-text-muted fw-semibold small text-uppercase">Students</span>
                    <span class="admin-stat-icon"><i class="bi bi-mortarboard"></i></span>
                </div>
                <div class="admin-stat-value tp-text-main fw-bold display-5 mt-2 mb-1"><%= stats.students %></div>
                <div class="tp-text-muted small">Registered learners</div>
            </article>
        </div>
    </section>

    <!-- Management Center -->
    <section class="mb-5" aria-labelledby="management-title">
        <div class="mb-4">
            <h3 id="management-title" class="tp-text-main fw-bold mb-0">Management center</h3>
            <p class="tp-text-muted small mb-0">Choose a module to manage your ThesisPilot records</p>
        </div>

        <div class="admin-module-grid">
            <!-- Academic Structure Module -->
            <article class="tp-card h-100 d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background: rgba(234,88,12,0.1); color: var(--primary-color); font-size: 1.5rem;">
                        <i class="bi bi-diagram-3"></i>
                    </div>
                    <div>
                        <h4 class="tp-text-main fw-bold mb-0 fs-5">Academic structure</h4>
                        <p class="tp-text-muted small mb-0">Configure the foundation of your institution</p>
                    </div>
                </div>

                <nav class="admin-module-links d-flex flex-column gap-3 mt-auto" aria-label="Academic structure management">
                    <a href="/admin/departments" class="admin-module-link">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-buildings fs-4" style="color: var(--primary-light);"></i>
                            <div>
                                <strong class="d-block tp-text-main">Departments</strong>
                                <small class="tp-text-muted">Create, edit, and manage units</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right tp-text-muted" aria-hidden="true"></i>
                    </a>

                    <a href="/admin/chairmen" class="admin-module-link">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-person-workspace fs-4" style="color: var(--secondary-color);"></i>
                            <div>
                                <strong class="d-block tp-text-main">Department chairmen</strong>
                                <small class="tp-text-muted">Manage department heads</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right tp-text-muted" aria-hidden="true"></i>
                    </a>

                    <a href="/admin/sessions" class="admin-module-link">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-calendar-range fs-4" style="color: var(--warning);"></i>
                            <div>
                                <strong class="d-block tp-text-main">Academic sessions</strong>
                                <small class="tp-text-muted">Configure academic periods</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right tp-text-muted" aria-hidden="true"></i>
                    </a>
                </nav>
            </article>

            <!-- People and Access Module -->
            <article class="tp-card h-100 d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: var(--text-main); font-size: 1.5rem;">
                        <i class="bi bi-people"></i>
                    </div>
                    <div>
                        <h4 class="tp-text-main fw-bold mb-0 fs-5">People and access</h4>
                        <p class="tp-text-muted small mb-0">Manage the people who use ThesisPilot</p>
                    </div>
                </div>

                <nav class="admin-module-links d-flex flex-column gap-3" aria-label="User management">
                    <a href="/admin/supervisors" class="admin-module-link">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-person-badge fs-4" style="color: var(--success);"></i>
                            <div>
                                <strong class="d-block tp-text-main">Faculty supervisors</strong>
                                <small class="tp-text-muted">View and manage teaching staff</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right tp-text-muted" aria-hidden="true"></i>
                    </a>

                    <a href="/admin/students" class="admin-module-link">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-mortarboard fs-4" style="color: var(--text-main);"></i>
                            <div>
                                <strong class="d-block tp-text-main">Enrolled students</strong>
                                <small class="tp-text-muted">Review student records</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right tp-text-muted" aria-hidden="true"></i>
                    </a>
                </nav>

                <div class="mt-auto pt-4">
                    <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px dashed var(--border-color);">
                        <i class="bi bi-info-circle me-2 tp-text-muted"></i>
                        <span class="tp-text-muted small">Keep records accurate to ensure smooth allocation processes.</span>
                    </div>
                </div>
            </article>
        </div>
    </section>
</main>

<%- include('../partials/footer') %>