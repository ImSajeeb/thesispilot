<%- include('../partials/header') %>

<div class="container-fluid tp-main-content py-4 px-md-4" style="max-width: 1400px;">
    
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bolder tp-text-main mb-1" style="letter-spacing: -0.5px;">Departments</h2>
            <p class="tp-text-muted mb-0">Manage university academic departments[cite: 6].</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin/dashboard" class="btn tp-btn-surface shadow-sm d-flex align-items-center">
                <i class="bi bi-arrow-left me-2"></i> Dashboard
            </a>
            <button class="btn tp-btn-accent shadow-sm d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#addDepartmentModal">
                <i class="bi bi-plus-lg me-2"></i> Add Department
            </button>
        </div>
    </div>

    <!-- Flash Messages -->
    <!-- <% if (typeof successMsg !== 'undefined' && successMsg && successMsg.length > 0) { %>
        <div class="alert tp-alert-success border-0 shadow-sm rounded-3"><i class="bi bi-check-circle-fill me-2"></i><%= successMsg %></div>
    <% } %>
    <% if (typeof errorMsg !== 'undefined' && errorMsg && errorMsg.length > 0) { %>
        <div class="alert tp-alert-danger border-0 shadow-sm rounded-3"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= errorMsg %></div>
    <% } %> -->

    <!-- Data Table Card -->
    <div class="tp-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table tp-table tp-table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="px-4 py-3">Department Name</th>
                        <th class="px-4 py-3">Short Code</th>
                        <th class="px-4 py-3">Status</th>
                        <th class="px-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof departments !== 'undefined' && departments && departments.length > 0) { %>
                        <% departments.forEach(dept => { %>
                            <tr>
                                <td class="px-4 py-3 fw-bold tp-text-main"><%= dept.name %></td>
                                <td class="px-4 py-3">
                                    <span class="tp-badge" style="background: rgba(255,255,255,0.05); color: var(--text-muted); border: 1px solid var(--border-color);"><%= dept.code %></span>
                                </td>
                                <td class="px-4 py-3">
                                    <% if (dept.status === 'active') { %>
                                        <span class="tp-badge tp-badge-success">Active</span>
                                    <% } else { %>
                                        <span class="tp-badge tp-badge-danger">Disabled</span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <!-- Edit Button -->
                                    <button class="btn btn-sm tp-btn-surface me-1" data-bs-toggle="modal" data-bs-target="#editModal-<%= dept.id %>">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </button>
                                    
                                    <!-- Toggle Status Button -->
                                    <form action="/admin/departments/<%= dept.id %>/toggle-status" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm tp-btn-surface me-1 <%= dept.status === 'active' ? 'text-warning' : 'text-success' %>">
                                            <i class="bi <%= dept.status === 'active' ? 'bi-archive' : 'bi-arrow-counterclockwise' %>"></i> 
                                            <%= dept.status === 'active' ? 'Deactivate' : 'Activate' %>
                                        </button>
                                    </form>

                                    <!-- Delete Button -->
                                    <form action="/admin/departments/<%= dept.id %>/delete" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm tp-btn-outline-danger" onclick="return confirm('Permanently delete this department?');">
                                            <i class="bi bi-trash3-fill"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <i class="bi bi-buildings display-4 tp-text-muted mb-3 d-block opacity-50"></i>
                                <h5 class="fw-bold tp-text-main">No Departments Found</h5>
                                <p class="tp-text-muted">You have not added any academic departments yet.</p>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODALS PLACED SAFELY AT THE BOTTOM OF PAGE -->
<!-- ========================================== -->

<!-- Add Department Modal -->
<div class="modal fade" id="addDepartmentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content tp-card border-0 shadow-lg p-0">
            <div class="modal-header border-bottom-0 pb-2 pt-4 px-4">
                <h5 class="fw-bolder tp-text-main mb-0">New Department</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/departments/create" method="POST">
                <div class="modal-body px-4 py-3">
                    <div class="mb-3">
                        <label class="form-label fw-bold tp-text-muted small text-uppercase">Name</label>
                        <input type="text" name="name" class="form-control tp-form-control py-2.5" placeholder="e.g. Computer Science" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold tp-text-muted small text-uppercase">Short Code</label>
                        <input type="text" name="code" class="form-control tp-form-control py-2.5" placeholder="e.g. CSE" required>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                    <button type="submit" class="btn tp-btn-accent w-100 py-2">Create Department</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modals Loop -->
<% if (typeof departments !== 'undefined' && departments && departments.length > 0) { %>
    <% departments.forEach(dept => { %>
        <!-- Edit Modal -->
        <div class="modal fade text-start" id="editModal-<%= dept.id %>" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content tp-card border-0 shadow-lg p-0">
                    <div class="modal-header border-bottom-0 pb-2 pt-4 px-4">
                        <h5 class="fw-bolder tp-text-main mb-0">Edit Department</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/admin/departments/<%= dept.id %>/update" method="POST">
                        <div class="modal-body px-4 py-3">
                            <div class="mb-3">
                                <label class="form-label fw-bold tp-text-muted small text-uppercase">Department Name</label>
                                <input type="text" name="name" class="form-control tp-form-control py-2.5" value="<%= dept.name %>" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold tp-text-muted small text-uppercase">Short Code</label>
                                <input type="text" name="code" class="form-control tp-form-control py-2.5" value="<%= dept.code %>" required>
                            </div>
                        </div>
                        <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                            <button type="submit" class="btn tp-btn-accent w-100 py-2">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    <% }) %>
<% } %>

<%- include('../partials/footer') %>