<%- include('../partials/header') %>

<div class="container-fluid tp-main-content py-4 px-md-4" style="max-width: 1400px;">
    
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bolder tp-text-main mb-1" style="letter-spacing: -0.5px;">Academic Sessions</h2>
            <p class="tp-text-muted mb-0">Manage university sessions globally.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin/dashboard" class="btn tp-btn-surface shadow-sm d-flex align-items-center">
                <i class="bi bi-arrow-left me-2"></i> Dashboard
            </a>
            <button class="btn tp-btn-accent shadow-sm d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#addSessionModal">
                <i class="bi bi-plus-lg me-2"></i> Add Session
            </button>
        </div>
    </div>

    <!-- Flash Messages -->
    <!-- <% if (typeof successMsg !== 'undefined' && successMsg && successMsg.length > 0) { %>
        <div class="alert tp-alert-success border-0 shadow-sm rounded-3"><i class="bi bi-check-circle-fill me-2"></i><%= successMsg %></div>
    <% } %>
    <% if (typeof errorMsg !== 'undefined' && errorMsg && errorMsg.length > 0) { %>
        <div class="alert tp-alert-danger border-0 shadow-sm rounded-3"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= errorMsg %></div>
    <% } %> -->

    <!-- Filter Bar -->
    <div class="tp-card mb-4 p-3">
        <form action="/admin/sessions" method="GET" class="row gx-3 align-items-center m-0">
            <div class="col-auto">
                <label class="fw-bold tp-text-muted mb-0"><i class="bi bi-funnel me-1"></i> Filter:</label>
            </div>
            <div class="col-md-4">
                <select name="department_id" class="form-select tp-form-control py-2" onchange="this.form.submit()">
                    <option value="" style="background: var(--bg-base); color: var(--text-main);">All Departments</option>
                    <% departments.forEach(dept => { %>
                        <option value="<%= dept.id %>" <%= filters.department_id == dept.id ? 'selected' : '' %> style="background: var(--bg-base); color: var(--text-main);"><%= dept.name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-4 mt-2 mt-md-0">
                <select name="session_name" class="form-select tp-form-control py-2" onchange="this.form.submit()">
                    <option value="" style="background: var(--bg-base); color: var(--text-main);">All Session Years</option>
                    <% uniqueSessions.forEach(session => { %>
                        <option value="<%= session.session_name %>" <%= filters.session_name == session.session_name ? 'selected' : '' %> style="background: var(--bg-base); color: var(--text-main);"><%= session.session_name %></option>
                    <% }) %>
                </select>
            </div>
        </form>
    </div>

    <!-- Data Table Card -->
    <div class="tp-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table tp-table tp-table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="px-4 py-3">Session Name</th>
                        <th class="px-4 py-3">Duration</th>
                        <th class="px-4 py-3">Department</th>
                        <th class="px-4 py-3">Stats</th>
                        <th class="px-4 py-3">Status</th>
                        <th class="px-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof sessions !== 'undefined' && sessions && sessions.length > 0) { %>
                        <% sessions.forEach(session => { %>
                            <tr>
                                <td class="px-4 py-3 fw-bold tp-text-main"><%= session.session_name %></td>
                                <td class="px-4 py-3 fw-semibold tp-text-muted"><%= session.start_year %> - <%= session.end_year %></td>
                                <td class="px-4 py-3">
                                    <span class="tp-badge" style="background: rgba(255,255,255,0.05); color: var(--text-muted); border: 1px solid var(--border-color);"><%= session.department_name %></span>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="small fw-semibold tp-text-main mb-1">
                                        <i class="bi bi-people-fill me-1" style="color: var(--primary-light);"></i> <%= session.student_count %> Students
                                    </div>
                                    <div class="small fw-semibold tp-text-muted">
                                        <i class="bi bi-journal-text me-1" style="color: var(--secondary-color);"></i> <%= session.thesis_count %> Theses
                                    </div>
                                </td>
                                <td class="px-4 py-3">
                                    <% if (session.status === 'active') { %>
                                        <span class="tp-badge tp-badge-success">Active</span>
                                    <% } else { %>
                                        <span class="tp-badge tp-badge-danger">Archived</span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <!-- Edit Button -->
                                    <button class="btn btn-sm tp-btn-surface me-1" data-bs-toggle="modal" data-bs-target="#editModal-<%= session.id %>">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </button>
                                    
                                    <!-- Toggle Status -->
                                    <form action="/admin/sessions/<%= session.id %>/toggle-status" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm tp-btn-surface me-1 <%= session.status === 'active' ? 'text-warning' : 'text-success' %>">
                                            <i class="bi <%= session.status === 'active' ? 'bi-archive' : 'bi-arrow-counterclockwise' %>"></i>
                                            <%= session.status === 'active' ? 'Archive' : 'Activate' %>
                                        </button>
                                    </form>

                                    <!-- Delete -->
                                    <form action="/admin/sessions/<%= session.id %>/delete" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm tp-btn-outline-danger" onclick="return confirm('Permanently delete this session?');">
                                            <i class="bi bi-trash3-fill"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="bi bi-calendar-x display-4 tp-text-muted mb-3 d-block opacity-50"></i>
                                <h5 class="fw-bold tp-text-main">No Sessions Found</h5>
                                <p class="tp-text-muted">Try adjusting your filters or create a new session.</p>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODALS PLACED SAFELY AT THE BOTTOM OF PAGE -->
<!-- ========================================== -->

<!-- Add Session Modal -->
<div class="modal fade" id="addSessionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content tp-card border-0 shadow-lg p-0">
            <div class="modal-header border-bottom-0 pb-2 pt-4 px-4">
                <h5 class="fw-bolder tp-text-main mb-0">New Session</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/sessions/create" method="POST">
                <div class="modal-body px-4 py-3">
                    <div class="mb-3">
                        <label class="form-label fw-bold tp-text-muted small text-uppercase">Name (e.g. 2023-2024)</label>
                        <input type="text" name="session_name" class="form-control tp-form-control py-2.5" required>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold tp-text-muted small text-uppercase">Start Year</label>
                            <input type="number" name="start_year" class="form-control tp-form-control py-2.5" required>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold tp-text-muted small text-uppercase">End Year</label>
                            <input type="number" name="end_year" class="form-control tp-form-control py-2.5" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold tp-text-muted small text-uppercase">Department</label>
                        <select name="department_id" class="form-select tp-form-control py-2.5" required>
                            <option value="" style="background: var(--bg-base); color: var(--text-main);">Select Department</option>
                            <% departments.forEach(dept => { %>
                                <option value="<%= dept.id %>" style="background: var(--bg-base); color: var(--text-main);"><%= dept.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                    <button type="submit" class="btn tp-btn-accent w-100 py-2">Create Session</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modals Loop -->
<% if (typeof sessions !== 'undefined' && sessions && sessions.length > 0) { %>
    <% sessions.forEach(session => { %>
        <!-- Edit Modal -->
        <div class="modal fade text-start" id="editModal-<%= session.id %>" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content tp-card border-0 shadow-lg p-0">
                    <div class="modal-header border-bottom-0 pb-2 pt-4 px-4">
                        <h5 class="fw-bolder tp-text-main mb-0">Edit Session</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/admin/sessions/<%= session.id %>/update" method="POST">
                        <div class="modal-body px-4 py-3">
                            <div class="mb-3">
                                <label class="form-label fw-bold tp-text-muted small text-uppercase">Session Name</label>
                                <input type="text" name="session_name" class="form-control tp-form-control py-2.5" value="<%= session.session_name %>" required>
                            </div>
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label class="form-label fw-bold tp-text-muted small text-uppercase">Start Year</label>
                                    <input type="number" name="start_year" class="form-control tp-form-control py-2.5" value="<%= session.start_year %>" required>
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="form-label fw-bold tp-text-muted small text-uppercase">End Year</label>
                                    <input type="number" name="end_year" class="form-control tp-form-control py-2.5" value="<%= session.end_year %>" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold tp-text-muted small text-uppercase">Department</label>
                                <select name="department_id" class="form-select tp-form-control py-2.5" required>
                                    <% departments.forEach(dept => { %>
                                        <option value="<%= dept.id %>" <%= dept.id === session.department_id ? 'selected' : '' %> style="background: var(--bg-base); color: var(--text-main);"><%= dept.name %></option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                            <button type="submit" class="btn tp-btn-accent w-100 py-2">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    <% }) %>
<% } %>

<%- include('../partials/footer') %>