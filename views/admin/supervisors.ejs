<%- include('../partials/header') %>

<div class="container-fluid tp-main-content py-4 px-md-4" style="max-width: 1400px;">
    
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bolder tp-text-main mb-1" style="letter-spacing: -0.5px;">Global Supervisors</h2>
            <p class="tp-text-muted mb-0">Manage faculty across all departments.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin/dashboard" class="btn tp-btn-surface shadow-sm d-flex align-items-center">
                <i class="bi bi-arrow-left me-2"></i> Dashboard
            </a>
            <button class="btn tp-btn-accent shadow-sm d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#addSupervisorModal">
                <i class="bi bi-plus-lg me-2"></i> Add Supervisor
            </button>
        </div>
    </div>

    <!-- Flash Messages -->
    <!-- <% if (typeof successMsg !== 'undefined' && successMsg && successMsg.length > 0) { %>
        <div class="alert tp-alert-success border-0 shadow-sm rounded-3"><i class="bi bi-check-circle-fill me-2"></i><%= successMsg %></div>
    <% } %>
    <% if (typeof errorMsg !== 'undefined' && errorMsg && errorMsg.length > 0) { %>
        <div class="alert tp-alert-danger border-0 shadow-sm rounded-3"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= errorMsg %></div>
    <% } %> -->

    <!-- Filter Bar -->
    <div class="tp-card mb-4 p-3 d-flex align-items-center">
        <form action="/admin/supervisors" method="GET" class="w-100 d-flex flex-wrap align-items-center gap-3 m-0">
            <label class="fw-bold tp-text-muted mb-0"><i class="bi bi-funnel me-1"></i> Filter:</label>
            <div style="min-width: 250px;">
                <select name="department_id" class="form-select tp-form-control py-2" onchange="this.form.submit()">
                    <option value="" style="background: var(--bg-base); color: var(--text-main);">All Departments</option>
                    <% departments.forEach(dept => { %>
                        <option value="<%= dept.id %>" <%= filters.department_id == dept.id ? 'selected' : '' %> style="background: var(--bg-base); color: var(--text-main);"><%= dept.name %></option>
                    <% }) %>
                </select>
            </div>
        </form>
    </div>

    <!-- Data Table Card -->
    <div class="tp-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table tp-table tp-table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="px-4 py-3">Faculty Profile</th>
                        <th class="px-4 py-3">Credentials</th>
                        <th class="px-4 py-3">Department</th>
                        <th class="px-4 py-3">Status</th>
                        <th class="px-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof supervisors !== 'undefined' && supervisors && supervisors.length > 0) { %>
                        <% supervisors.forEach(sup => { %>
                            <tr>
                                <td class="px-4 py-3">
                                    <div class="fw-bold tp-text-main"><%= sup.name %></div>
                                    <div class="tp-text-muted small mt-1"><i class="bi bi-envelope me-1"></i><%= sup.email %></div>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="fw-semibold tp-text-main"><%= sup.supervisor_id %></div>
                                    <div class="tp-text-muted small mt-1"><%= sup.designation %></div>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="tp-badge" style="background: rgba(255,255,255,0.05); color: var(--text-muted); border: 1px solid var(--border-color);"><%= sup.department_name %></span>
                                </td>
                                
                                <td class="px-4 py-3">
                                    <% if (sup.account_status === 'active') { %>
                                        <span class="tp-badge tp-badge-success">Active</span>
                                    <% } else { %>
                                        <span class="tp-badge tp-badge-danger">Archived</span>
                                    <% } %>
                                </td>
                                
                                <td class="px-4 py-3 text-end">
                                    <% if (sup.account_status !== 'active') { %>
                                        <form action="/admin/users/<%= sup.user_id %>/reactivate" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm tp-btn-surface text-success me-1" onclick="return confirm('Reactivate this supervisor account?');">
                                                <i class="bi bi-arrow-counterclockwise"></i> Reactivate
                                            </button>
                                        </form>
                                        <form action="/admin/users/<%= sup.user_id %>/hard-delete" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm tp-btn-outline-danger" onclick="return confirm('WARNING: This will permanently wipe this supervisor. Continue?');">
                                                <i class="bi bi-trash3-fill"></i> Hard Delete
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <button class="btn btn-sm tp-btn-surface me-1" data-bs-toggle="modal" data-bs-target="#editModal-<%= sup.id %>">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </button>
                                        <button class="btn btn-sm tp-btn-surface me-1" data-bs-toggle="modal" data-bs-target="#passwordModal-<%= sup.user_id %>">
                                            <i class="bi bi-key"></i> Pass
                                        </button>
                                        <form action="/admin/supervisors/<%= sup.id %>/delete" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm tp-btn-surface text-warning" onclick="return confirm('Archive this supervisor account?');">
                                                <i class="bi bi-archive"></i> Archive
                                            </button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="bi bi-person-badge display-4 tp-text-muted mb-3 d-block opacity-50"></i>
                                <h5 class="fw-bold tp-text-main">No Supervisors Found</h5>
                                <p class="tp-text-muted">No faculty members match your filter criteria.</p>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODALS PLACED SAFELY AT THE BOTTOM OF PAGE -->
<!-- ========================================== -->

<!-- Add Supervisor Modal -->
<div class="modal fade" id="addSupervisorModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content tp-card border-0 shadow-lg p-0">
            <div class="modal-header border-bottom-0 pb-2 pt-4 px-4">
                <h5 class="fw-bolder tp-text-main mb-0">Register Faculty</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/supervisors/create" method="POST">
                <div class="modal-body px-4 py-3">
                    <div class="mb-3">
                        <label class="form-label fw-bold tp-text-muted small text-uppercase">Name</label>
                        <input type="text" name="name" class="form-control tp-form-control py-2.5" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold tp-text-muted small text-uppercase">Email</label>
                        <input type="email" name="email" class="form-control tp-form-control py-2.5" required>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold tp-text-muted small text-uppercase">Faculty ID</label>
                            <input type="text" name="supervisor_id" class="form-control tp-form-control py-2.5" required>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold tp-text-muted small text-uppercase">Designation</label>
                            <input type="text" name="designation" class="form-control tp-form-control py-2.5" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold tp-text-muted small text-uppercase">Department</label>
                        <select name="department_id" class="form-select tp-form-control py-2.5" required>
                            <option value="" style="background: var(--bg-base); color: var(--text-main);">Select Department</option>
                            <% departments.forEach(dept => { %>
                                <option value="<%= dept.id %>" style="background: var(--bg-base); color: var(--text-main);"><%= dept.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                    <button type="submit" class="btn tp-btn-accent w-100 py-2">Create Supervisor</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit & Password Modals Generation Loop -->
<% if (typeof supervisors !== 'undefined' && supervisors && supervisors.length > 0) { %>
    <% supervisors.forEach(sup => { %>
        
        <!-- Edit Modal -->
        <div class="modal fade text-start" id="editModal-<%= sup.id %>" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content tp-card border-0 shadow-lg p-0">
                    <div class="modal-header border-bottom-0 pb-2 pt-4 px-4">
                        <h5 class="fw-bolder tp-text-main mb-0">Edit Supervisor</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/admin/supervisors/<%= sup.id %>/update" method="POST">
                        <div class="modal-body px-4 py-3">
                            <div class="mb-3">
                                <label class="form-label fw-bold tp-text-muted small text-uppercase">Name</label>
                                <input type="text" name="name" class="form-control tp-form-control py-2.5" value="<%= sup.name %>" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold tp-text-muted small text-uppercase">Email</label>
                                <input type="email" name="email" class="form-control tp-form-control py-2.5" value="<%= sup.email %>" required>
                            </div>
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label class="form-label fw-bold tp-text-muted small text-uppercase">Faculty ID</label>
                                    <input type="text" name="supervisor_id" class="form-control tp-form-control py-2.5" value="<%= sup.supervisor_id %>" required>
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="form-label fw-bold tp-text-muted small text-uppercase">Designation</label>
                                    <input type="text" name="designation" class="form-control tp-form-control py-2.5" value="<%= sup.designation %>" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold tp-text-muted small text-uppercase">Department</label>
                                <select name="department_id" class="form-select tp-form-control py-2.5" required>
                                    <% departments.forEach(dept => { %>
                                        <option value="<%= dept.id %>" <%= dept.name === sup.department_name ? 'selected' : '' %> style="background: var(--bg-base); color: var(--text-main);"><%= dept.name %></option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                            <button type="submit" class="btn tp-btn-accent w-100 py-2">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Force Password Reset Modal -->
        <div class="modal fade text-start" id="passwordModal-<%= sup.user_id %>" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content tp-card border-0 shadow-lg p-0">
                    <div class="modal-header border-bottom-0 pb-2 pt-4 px-4">
                        <h5 class="fw-bolder tp-text-main mb-0">Force Reset Password</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/admin/users/<%= sup.user_id %>/reset-password" method="POST">
                        <div class="modal-body px-4 py-3">
                            <p class="tp-text-muted small mb-3">Set a new password for <strong class="tp-text-main"><%= sup.name %></strong>.</p>
                            <div class="mb-3">
                                <label class="form-label fw-bold tp-text-muted small text-uppercase">New Password</label>
                                <input type="password" name="new_password" class="form-control tp-form-control py-2.5" minlength="4" required placeholder="Enter new password">
                            </div>
                        </div>
                        <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                            <button type="submit" class="btn btn-danger w-100 py-2 fw-bold border-0">Force Reset</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    <% }) %>
<% } %>

<%- include('../partials/footer') %>