<%- include('../partials/header') %>

<div class="container tp-auth-wrapper py-5">
    <div class="tp-card w-100 mx-auto" style="max-width: 450px;">
        <div class="card-body p-2 p-md-4">
            
            <div class="text-center mb-4">
                <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3" 
                     style="width: 60px; height: 60px; font-size: 1.5rem; background: rgba(234, 88, 12, 0.1); color: var(--primary-color);">
                    <i class="bi bi-key-fill"></i>
                </div>
                <h3 class="fw-bolder tp-text-main">Forgot Password</h3>
                <p class="tp-text-muted small">Enter your student email to receive a reset code.</p>
            </div>

            <!-- Flash messages handled globally in header.ejs -->

            <form action="/auth/forgot-password" method="POST" autocomplete="off">
                <div class="mb-4">
                    <label class="form-label fw-bold tp-text-muted small text-uppercase">Email Address</label>
                    <input type="email" class="form-control tp-form-control py-2.5 fw-semibold" name="email" required placeholder="name@university.edu" autofocus>
                </div>
                
                <button type="submit" class="btn tp-btn-accent w-100 py-2.5 mb-3">
                    Send Reset Code
                </button>
            </form>
            
            <div class="text-center">
                <a href="/auth/login" class="tp-text-muted text-decoration-none small transition-all hover-primary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Login
                </a>
            </div>
            
        </div>
    </div>
</div>

<%- include('../partials/footer') %>