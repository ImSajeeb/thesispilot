<%- include('../partials/header') %>

<div class="container tp-auth-wrapper py-5">
    <div class="tp-card w-100 mx-auto" style="max-width: 450px;">
        <div class="card-body p-2 p-md-4">
            
            <div class="text-center mb-4">
                <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3" 
                     style="width: 60px; height: 60px; font-size: 1.5rem; background: rgba(234, 88, 12, 0.1); color: var(--primary-color);">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h3 class="fw-bolder tp-text-main">Welcome Back</h3>
                <p class="tp-text-muted small">Sign in to your academic portal account</p>
            </div>

            <!-- Flash Messages (Commented out to avoid double rendering with header.ejs) -->
            <!-- <% /* %>
            <% if (typeof successMsg !== 'undefined' && successMsg && successMsg.length > 0) { %>
                <div class="alert tp-alert-success border-0 shadow-sm rounded-4 mb-3 py-2 small"><%= successMsg %></div>
            <% } %>
            <% if (typeof errorMsg !== 'undefined' && errorMsg && errorMsg.length > 0) { %>
                <div class="alert tp-alert-danger border-0 shadow-sm rounded-4 mb-3 py-2 small"><%= errorMsg %></div>
            <% } %>
            <% */ %> -->

            <form action="/auth/login" method="POST">
                <div class="mb-3">
                    <label class="form-label fw-bold tp-text-muted small text-uppercase">Email Address</label>
                    <input type="email" class="form-control tp-form-control py-2.5 fw-semibold" name="email" required placeholder="name@university.edu" autocomplete="off">
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold tp-text-muted small text-uppercase mb-0">Password</label>
                        <a href="/auth/forgot-password" class="tp-text-primary small text-decoration-none fw-semibold">Forgot password?</a>
                    </div>
                    <input type="password" class="form-control tp-form-control py-2.5 fw-semibold" name="password" required placeholder="••••••••" autocomplete="new-password">
                </div>

                <button type="submit" class="btn tp-btn-accent w-100 py-2.5 mb-3">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                </button>

                <div class="text-center">
                    <span class="tp-text-muted small">Don't have an account?</span> 
                    <a href="/auth/register" class="fw-bold tp-text-primary text-decoration-none small">Register Student</a>
                </div>
            </form>

        </div>
    </div>
</div>

<%- include('../partials/footer') %>