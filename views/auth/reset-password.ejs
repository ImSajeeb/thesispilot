<%- include('../partials/header') %>

<div class="container tp-auth-wrapper py-5">
    <div class="tp-card w-100 mx-auto" style="max-width: 450px;">
        <div class="card-body p-4 p-md-5">
            
            <div class="text-center mb-4">
                <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3" 
                     style="width: 60px; height: 60px; font-size: 1.5rem; background: rgba(234, 88, 12, 0.1); color: var(--primary-color);">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h3 class="fw-bolder tp-text-main">New Password</h3>
                <p class="tp-text-muted small">Create a secure new password[cite: 6].</p>
            </div>

            <!-- Flash Messages (Commented out to avoid double rendering with header.ejs) -->
            <% /* %>
            <% if (typeof errorMsg !== 'undefined' && errorMsg && errorMsg.length > 0) { %> 
                <div class="alert tp-alert-danger border-0 shadow-sm rounded-4 mb-3 py-2 small"><%= errorMsg %></div> 
            <% } %>
            <% */ %>

            <form action="/auth/reset-password" method="POST" autocomplete="off">
                <div class="mb-3">
                    <label class="form-label fw-bold tp-text-muted small text-uppercase">New Password</label>
                    <input type="password" class="form-control tp-form-control py-2.5 fw-semibold" name="password" minlength="4" required placeholder="••••••••" autofocus>
                </div>
                
                <div class="mb-4">
                    <label class="form-label fw-bold tp-text-muted small text-uppercase">Confirm Password</label>
                    <input type="password" class="form-control tp-form-control py-2.5 fw-semibold" name="confirm_password" minlength="4" required placeholder="••••••••">
                </div>

                <button type="submit" class="btn tp-btn-accent w-100 shadow mb-3 py-2.5 fw-bold">Update Password</button>
            </form>

        </div>
    </div>
</div>

<%- include('../partials/footer') %>