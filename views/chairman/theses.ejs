<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/chairman-theses.css">

<main class="container-fluid chairman-theses-page py-4 px-md-4">
    
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <div class="theses-eyebrow"><span class="theses-eyebrow-line"></span> ACADEMIC OVERSIGHT</div>
            <h2 class="theses-page-title mb-2">Thesis Management</h2>
            <p class="theses-page-subtitle mb-0">Track thesis topics, proposal reviews, supervisor assignments, and completion progress across sessions.</p>
        </div>
        <div class="d-flex gap-2 d-print-none">
            <button onclick="window.print()" class="btn theses-btn theses-btn-secondary btn-action">
                <i class="bi bi-printer-fill me-1"></i> Print / PDF Report
            </button>
            <a href="/chairman/dashboard" class="btn theses-btn theses-btn-quiet btn-action">← Dashboard</a>
        </div>
    </div>

    <!-- Metrics Strip -->
    <div class="row g-3 mb-4 d-print-none">
        <div class="col-6 col-md-3">
            <div class="stat-box">
                <div class="stat-label">Total Theses Tracked</div>
                <div class="stat-val text-primary"><%= theses.length %></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-box">
                <div class="stat-label">Proposals Approved</div>
                <div class="stat-val text-info"><%= theses.filter(t => t.thesis_status === 'proposal_approved').length %></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-box">
                <div class="stat-label">Under Review / Revision</div>
                <div class="stat-val text-warning"><%= theses.filter(t => t.thesis_status === 'under_review' || t.thesis_status === 'revision_required').length %></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-box">
                <div class="stat-label">Completed</div>
                <div class="stat-val text-success"><%= theses.filter(t => t.thesis_status === 'completed').length %></div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <section class="theses-filter-panel mb-4 d-print-none">
        <div class="theses-panel-heading"><div class="theses-panel-icon"><i class="bi bi-sliders2"></i></div><div><h3>Refine thesis records</h3><p>Choose a session and workflow stage to narrow the report.</p></div></div>
        <form method="GET" action="/chairman/theses" class="row g-2 align-items-center m-0">

            <div class="col-md-4">
                <select name="session_id" class="form-select theses-select" onchange="this.form.submit()">
                    <% sessions.forEach(session => { %>
                        <option value="<%= session.id %>" <%= Number(selectedSessionId) === Number(session.id) ? 'selected' : '' %>>
                            <%= session.session_name %> <%= session.status === 'active' ? ' [Active]' : '' %>
                        </option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select theses-select" onchange="this.form.submit()">
                    <option value="">All Workflow Statuses</option>
                    <option value="supervisor_allocated" <%= statusFilter === 'supervisor_allocated' ? 'selected' : '' %>>Supervisor Allocated</option>
                    <option value="proposal_submitted" <%= statusFilter === 'proposal_submitted' ? 'selected' : '' %>>Proposal Submitted</option>
                    <option value="under_review" <%= statusFilter === 'under_review' ? 'selected' : '' %>>Under Review</option>
                    <option value="revision_required" <%= statusFilter === 'revision_required' ? 'selected' : '' %>>Revision Required</option>
                    <option value="proposal_approved" <%= statusFilter === 'proposal_approved' ? 'selected' : '' %>>Proposal Approved</option>
                    <option value="completed" <%= statusFilter === 'completed' ? 'selected' : '' %>>Completed</option>
                </select>
            </div>
            <div class="col-md-2 d-flex">
                <a href="/chairman/theses" class="btn theses-btn theses-btn-reset w-100">Reset Filters</a>
            </div>
        </form>
    </section>

    <!-- Main Table Card -->
    <section class="theses-records-panel">
        <div class="theses-records-heading d-print-none"><div><div class="theses-section-kicker">RECORDS OVERVIEW</div><h3>Thesis register</h3><p>Student, topic, supervisor, and current milestone in one view.</p></div><span class="theses-count"><strong><%= theses.length %></strong> records</span></div>
        <div class="print-title">Department Thesis Progress Report</div>
        <div class="table-responsive">
            <% if (theses.length === 0) { %>
                <div class="text-center py-5 text-muted">
                    <div class="theses-empty-icon"><i class="bi bi-journal-x"></i></div>
                    <h5 class="fw-bold">No matching thesis records</h5>
                    <p class="small text-secondary">Try another session or workflow status to see more records.</p>
                </div>
            <% } else { %>
                <table class="table theses-table">
                    <thead>
                        <tr>
                            <th>Student Details</th>
                            <th>Thesis Title</th>
                            <th>Assigned Supervisor</th>
                            <th>Milestone Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% theses.forEach(t => { %>
                            <tr>
                                <td>
                                    <div class="theses-student-name"><%= t.student_name %></div>
                                    <div class="text-secondary small font-monospace mt-0.5">ID: <%= t.student_code %></div>
                                </td>
                                <td>
                                    <% if (t.title) { %>
                                        <div class="theses-title-text"><%= t.title %></div>
                                    <% } else { %>
                                        <span class="text-muted fst-italic small">Title not submitted yet</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (t.supervisor_name) { %>
                                        <div class="theses-supervisor"><span class="theses-supervisor-icon"><i class="bi bi-person-badge"></i></span><%= t.supervisor_name %></div>
                                    <% } else { %>
                                        <span class="badge bg-light text-danger border border-danger border-opacity-25 px-2 py-1">Unassigned</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% 
                                        let badgeClass = 'badge-allocated';
                                        let readableStatus = t.thesis_status.replace(/_/g, ' ').toUpperCase();
                                        if (t.thesis_status === 'completed') badgeClass = 'badge-completed';
                                        else if (t.thesis_status === 'proposal_approved') badgeClass = 'badge-approved';
                                        else if (t.thesis_status === 'under_review' || t.thesis_status === 'revision_required') badgeClass = 'badge-review';
                                        else if (t.thesis_status === 'proposal_submitted') badgeClass = 'badge-submitted';
                                    %>
                                    <span class="badge-status <%= badgeClass %>"><%= readableStatus %></span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </section>
</main>

<%- include('../partials/footer') %>