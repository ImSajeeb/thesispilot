<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ThesisPilot — Academic & Thesis Management System</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/components.css">
    <style>
        /* Compact, fixed flash messages: do not reserve vertical page space. */
        .tp-flash-container {
            position: fixed;
            top: 1rem;
            left: 50%;
            transform: translateX(-50%);
            width: max-content;
            max-width: min(92vw, 34rem);
            margin: 0 !important;
            padding: 0;
            z-index: 2000;
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: .45rem;
            pointer-events: none;
        }
        .tp-flash-container .tp-flash-message {
            width: 100%;
            margin: 0 !important;
            padding: .65rem 2.35rem .65rem .9rem;
            border: 1px solid transparent;
            border-radius: .7rem !important;
            box-shadow: 0 8px 26px rgba(0, 0, 0, .24);
            font-size: .875rem;
            line-height: 1.4;
            overflow-wrap: anywhere;
            pointer-events: auto;
            opacity: 1;
            transition: opacity .18s ease, transform .18s ease;
        }
        .tp-flash-container .tp-flash-success {
            color: #f0fdf4;
            background: #166534;
            border-color: #22c55e;
        }
        .tp-flash-container .tp-flash-error {
            color: #fff1f2;
            background: #9f1239;
            border-color: #fb7185;
        }
        .tp-flash-container .btn-close {
            position: absolute;
            top: 50%;
            right: .65rem;
            transform: translateY(-50%);
            padding: .3rem;
            background-size: .65rem;
            opacity: .85;
        }
        .tp-flash-container .tp-flash-message.tp-flash-hiding {
            opacity: 0;
            transform: translateY(-5px);
        }
        @media (max-width: 575.98px) {
            .tp-flash-container { top: .65rem; max-width: calc(100vw - 1.25rem); }
            .tp-flash-container .tp-flash-message { font-size: .82rem; padding: .6rem 2.2rem .6rem .75rem; }
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark tp-navbar px-4 py-3">
        <div class="container-fluid">
            <!-- Brand -->
            <a class="navbar-brand tp-brand d-flex align-items-center gap-2" href="/">
                <i class="bi bi-mortarboard-fill tp-brand-icon p-2 rounded-3 shadow-sm"></i> 
                ThesisPilot
            </a>
            
            <button class="navbar-toggler shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-center gap-3">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <!-- User Name & Department Badge Display -->
                        <li class="nav-item d-none d-md-flex align-items-center gap-2 px-3 py-1 tp-user-badge rounded-pill border">
                            <i class="bi bi-person-circle tp-text-primary fs-5"></i>
                            <div class="d-flex flex-column text-start tp-lh-sm">
                                <span class="fw-bold tp-text-main tp-fs-sm"><%= user.name %></span>
                                <span class="tp-text-muted tp-fs-xs">
                                    <%= typeof user.department_name !== 'undefined' && user.department_name ? user.department_name : (typeof department_name !== 'undefined' ? department_name : user.role.toUpperCase()) %>
                                </span>
                            </div>
                        </li>

                        <!-- Dashboard Link -->
                        <li class="nav-item">
                            <a class="nav-link fw-semibold tp-nav-link text-capitalize" href="/<%= user.role %>/dashboard">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        
                        <!-- Logout -->
                        <li class="nav-item">
                            <a class="btn tp-btn-outline-danger btn-sm fw-semibold rounded-pill px-3 py-2" href="/auth/logout">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        </li>
                    <% } else { %>
                        <!-- Logged Out State -->
                        <li class="nav-item">
                            <a class="nav-link fw-semibold tp-nav-link" href="/auth/login">Sign In</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn tp-btn-accent fw-semibold rounded-pill px-4 py-2" href="/auth/register">
                                Register Student
                            </a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Compact global flash messages: fixed overlay, so they never push page content down. -->
    <div class="tp-flash-container" aria-live="polite" aria-atomic="true">
        <% if (typeof successMsg !== 'undefined' && successMsg && successMsg.length > 0) { %>
            <div class="alert tp-flash-message tp-flash-success alert-dismissible show" role="status">
                <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i><span><%= successMsg %></span>
                <button type="button" class="btn-close btn-close-white" aria-label="Close message" data-tp-dismiss></button>
            </div>
        <% } %>

        <% if (typeof errorMsg !== 'undefined' && errorMsg && errorMsg.length > 0) { %>
            <div class="alert tp-flash-message tp-flash-error alert-dismissible show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i><span><%= errorMsg %></span>
                <button type="button" class="btn-close btn-close-white" aria-label="Close message" data-tp-dismiss></button>
            </div>
        <% } %>
    </div>

    <script>
        (function () {
            const messages = document.querySelectorAll('.tp-flash-container .tp-flash-message');
            messages.forEach(function (message) {
                let dismissed = false;
                function dismissMessage() {
                    if (dismissed) return;
                    dismissed = true;
                    message.classList.add('tp-flash-hiding');
                    window.setTimeout(function () { message.remove(); }, 200);
                }
                const closeButton = message.querySelector('[data-tp-dismiss]');
                if (closeButton) closeButton.addEventListener('click', dismissMessage);
                window.setTimeout(dismissMessage, 2000);
            });
        })();
    </script>