<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ThesisPilot — Academic & Thesis Management System</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/components.css">
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark tp-navbar px-4 py-3">
        <div class="container-fluid">
            <!-- Brand -->
            <a class="navbar-brand tp-brand d-flex align-items-center gap-2" href="/">
                <i class="bi bi-mortarboard-fill tp-brand-icon p-2 rounded-3 shadow-sm"></i> 
                ThesisPilot
            </a>
            
            <button class="navbar-toggler shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-center gap-3">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <!-- User Name & Department Badge Display -->
                        <li class="nav-item d-none d-md-flex align-items-center gap-2 px-3 py-1 tp-user-badge rounded-pill border">
                            <i class="bi bi-person-circle tp-text-primary fs-5"></i>
                            <div class="d-flex flex-column text-start tp-lh-sm">
                                <span class="fw-bold tp-text-main tp-fs-sm"><%= user.name %></span>
                                <span class="tp-text-muted tp-fs-xs">
                                    <%= typeof user.department_name !== 'undefined' && user.department_name ? user.department_name : (typeof department_name !== 'undefined' ? department_name : user.role.toUpperCase()) %>
                                </span>
                            </div>
                        </li>

                        <!-- Dashboard Link -->
                        <li class="nav-item">
                            <a class="nav-link fw-semibold tp-nav-link text-capitalize" href="/<%= user.role %>/dashboard">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        
                        <!-- Logout -->
                        <li class="nav-item">
                            <a class="btn tp-btn-outline-danger btn-sm fw-semibold rounded-pill px-3 py-2" href="/auth/logout">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        </li>
                    <% } else { %>
                        <!-- Logged Out State -->
                        <li class="nav-item">
                            <a class="nav-link fw-semibold tp-nav-link" href="/auth/login">Sign In</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn tp-btn-accent fw-semibold rounded-pill px-4 py-2" href="/auth/register">
                                Register Student
                            </a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Global Flash Messages Display -->
    <div class="container mt-4 tp-flash-container">
        <% if (typeof successMsg !== 'undefined' && successMsg && successMsg.length > 0) { %>
            <div class="alert tp-alert-success shadow-sm rounded-4 alert-dismissible fade show mb-4">
                <i class="bi bi-check-circle-fill me-2"></i> <%= successMsg %>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <% if (typeof errorMsg !== 'undefined' && errorMsg && errorMsg.length > 0) { %>
            <div class="alert tp-alert-danger shadow-sm rounded-4 alert-dismissible fade show mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= errorMsg %>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
    </div>